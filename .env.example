APP_NAME="SOMADI Farming"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.example

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
# Fuseau horaire de la ferme : Dakar (GMT, sans heure d'été)
APP_TIMEZONE=Africa/Dakar

APP_MAINTENANCE_DRIVER=file

# Coût bcrypt identique à password_hash() PHP par défaut : les mots de passe restent lisibles par l'ancienne application.
BCRYPT_ROUNDS=10

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base MySQL OVH (celle de l'application actuelle)
DB_CONNECTION=mysql
DB_HOST=xxxxx.mysql.db
DB_PORT=3306
DB_DATABASE=somadi
DB_USERNAME=somadi
DB_PASSWORD=
# Heure des sessions MySQL (GMT). Les dates automatiques des tables suivent ainsi l'heure de Dakar.
DB_TIMEZONE=+00:00

# Sessions et cache en fichiers : aucune table supplémentaire, fonctionne sur l'hébergement mutualisé OVH.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Envoi des e-mails (codes de connexion). Avec une adresse e-mail OVH (Email Pro ou MX Plan) :
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=no-reply@votre-domaine.example
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@votre-domaine.example"
MAIL_FROM_NAME="${APP_NAME}"

# Authentification renforcée
# Code PIN par e-mail après le mot de passe (false = mot de passe seul, interrupteur de secours si l'envoi d'e-mails tombe en panne)
SOMADI_PIN_EMAIL=true
# Connexion par empreinte sur téléphone
SOMADI_EMPREINTE=true
# Domaine des empreintes (vide = celui d'APP_URL). Le changer oblige chacun à réactiver son empreinte.
SOMADI_WEBAUTHN_DOMAINE=
